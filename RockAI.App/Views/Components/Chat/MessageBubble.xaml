<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:chat="clr-namespace:RockAI.App.Views.Components.Chat"
    x:Class="RockAI.App.Views.Components.Chat.MessageBubble">

    <Border
        Padding="10"
        Margin="0,4"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 8"
        BackgroundColor="{AppThemeBinding Light='#F2F2F2', Dark='#303030'}">

        <Border.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding MessageRole.Name}" Value="User">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light='#DCEBFF', Dark='#1D3557'}" />
            </DataTrigger>
            <DataTrigger TargetType="Border" Binding="{Binding MessageRole.Name}" Value="Assistant">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light='#E4F5E4', Dark='#244B2A'}" />
            </DataTrigger>
            <DataTrigger TargetType="Border" Binding="{Binding MessageRole.Name}" Value="System">
                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light='#FFF4D6', Dark='#594A22'}" />
            </DataTrigger>
        </Border.Triggers>

        <VerticalStackLayout Spacing="6">
            <HorizontalStackLayout Spacing="8">
                <Label Text="{Binding Role}" FontSize="11" FontAttributes="Bold" Opacity="0.7" />
                <Label Text="{Binding StatusText}" FontSize="11" Opacity="0.7" />
            </HorizontalStackLayout>

            <!-- Attachment chips (compact) -->
            <CollectionView
                ItemsSource="{Binding Attachments}"
                IsVisible="{Binding HasAttachments}"
                MaximumHeightRequest="48">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="4" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="6,2"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{AppThemeBinding Light='#D0D8E8', Dark='#3A4555'}">
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="📄" FontSize="12" VerticalOptions="Center" />
                                <Label Text="{Binding FileName}" FontSize="11" LineBreakMode="TailTruncation" MaxLines="1" WidthRequest="100" VerticalOptions="Center" />
                                <Label Text="{Binding StatusText}" FontSize="10" Opacity="0.7" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Assistant messages use Markdown; user/system use plain text for fidelity -->
            <chat:MarkdownView
                x:Name="MarkdownHost"
                IsVisible="{Binding IsAssistant}"
                Text="{Binding Content}" />

            <Label
                x:Name="PlainLabel"
                Text="{Binding Content}"
                LineBreakMode="WordWrap"
                IsVisible="{Binding IsPlainText}" />

            <chat:MessageActions />
        </VerticalStackLayout>
    </Border>
</ContentView>
