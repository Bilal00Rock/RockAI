<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="RockAI.App.Views.Components.Chat.EmptyChatView">

    <VerticalStackLayout
        VerticalOptions="Center"
        HorizontalOptions="Center"
        Spacing="8"
        Padding="24">
        <Label
            Text="RockAI"
            FontSize="28"
            FontAttributes="Bold"
            HorizontalTextAlignment="Center" />
        <Label
            Text="How can I help you?"
            FontSize="18"
            HorizontalTextAlignment="Center"
            Opacity="0.85" />
        <Label
            Text="Ask anything..."
            FontSize="14"
            HorizontalTextAlignment="Center"
            Opacity="0.6" />
    </VerticalStackLayout>
</ContentView>
