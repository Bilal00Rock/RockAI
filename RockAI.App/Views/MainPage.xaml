<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="RockAI.App.Views.MainPage"
    Title="RockAI"
    Appearing="OnPageAppearing">

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="280,*" Padding="16" RowSpacing="12" ColumnSpacing="16">
        <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
            <!--<Label Text="RockAI" FontSize="26" FontAttributes="Bold" />-->
            <Label  Text="{Binding WelcomeMessage}" VerticalOptions="Center" />
            <Button Grid.Column="2" Text="Log out" Command="{Binding LogoutCommand}" />
        </Grid>

        <Border Grid.Row="1" Grid.Column="0" StrokeThickness="1" Padding="12">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                <Label Text="Conversations" FontSize="18" FontAttributes="Bold" />
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Button Text="+ New Chat" Command="{Binding NewConversationCommand}" />
                    <Button Grid.Column="1" Text="Edit" Command="{Binding EditConversationCommand}" />
                    <Button Grid.Column="2" Text="Delete" Command="{Binding DeleteConversationCommand}" />
                </Grid>
                <CollectionView Grid.Row="2" ItemsSource="{Binding Conversations}" SelectionMode="Single" SelectedItem="{Binding SelectedConversation, Mode=TwoWay}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="2" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="5" StrokeThickness="1" Stroke="{AppThemeBinding Light='#DDDDDD', Dark='#444444'}"
                                    BackgroundColor="{AppThemeBinding Light='#F2F2F2', Dark='#303030'}" StrokeShape="RoundRectangle 8">
                                <Grid Padding="5"   Margin="0,0,0,8" RowDefinitions="Auto,Auto" BackgroundColor="{AppThemeBinding Light='#F2F2F2', Dark='#303030'}">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" />
                                    <Label Grid.Row="1" Text="{Binding CreatedAt, StringFormat='{0:g}'}" FontSize="11" Opacity="0.7" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="10">
            <Label Text="{Binding SelectedConversation.Title, TargetNullValue='Select a conversation'}" FontSize="22" FontAttributes="Bold" />
            <!--<CollectionView x:Name="MessagesCollectionView" Grid.Row="1" ItemsSource="{Binding Messages}" SelectionMode="None" ItemSizingStrategy="MeasureAllItems"  VerticalOptions="Fill">-->
            <CollectionView
    x:Name="MessagesCollectionView"
    Grid.Row="1"
    ItemsSource="{Binding Messages}"
    SelectionMode="None"
    ItemSizingStrategy="MeasureAllItems"
    VerticalOptions="Fill"
    VerticalScrollBarVisibility="Always"
                
    ItemsUpdatingScrollMode="KeepLastItemInView">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="0.5" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10" Margin="0,4" StrokeThickness="1" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light='#F2F2F2', Dark='#303030'}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding MessageRole.Name}" Value="User">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light='#DCEBFF', Dark='#1D3557'}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding MessageRole.Name}" Value="Assistant">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light='#E4F5E4', Dark='#244B2A'}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding MessageRole.Name}" Value="System">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light='#FFF4D6', Dark='#594A22'}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="4">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding Role}" FontSize="11" FontAttributes="Bold" Opacity="0.7" />
                                    <Label Text="{Binding StatusText}" FontSize="11" Opacity="0.7" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Content}" LineBreakMode="WordWrap" />
                                <Button Text="Retry" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}" Padding="8,2" HorizontalOptions="Start" />
                                <Button Text="Edit" Command="{Binding EditCommand}" IsVisible="{Binding CanEdit}" Padding="8,2" HorizontalOptions="Start" />
                                <Button Text="Delete" Command="{Binding DeleteCommand}" IsVisible="{Binding CanDelete}" Padding="8,2" HorizontalOptions="Start" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Label Grid.Row="2" Text="{Binding ErrorMessage}" TextColor="Red" />
            <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Editor Text="{Binding MessageText}" Placeholder="Type a message..." AutoSize="TextChanges" MaximumHeightRequest="100" />
                <Button Grid.Column="1" Text="Send" Command="{Binding SendMessageCommand}" IsVisible="{Binding IsSendVisible}" VerticalOptions="End" />
                <Button Grid.Column="1" Text="Stop" Command="{Binding StopGenerationCommand}" IsVisible="{Binding IsGenerating}" VerticalOptions="End" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>