<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:chat="clr-namespace:RockAI.App.Views.Components.Chat"
    xmlns:conv="clr-namespace:RockAI.App.Views.Components.Conversations"
    x:Class="RockAI.App.Views.MainPage"
    Title="RockAI"
    Appearing="OnPageAppearing">

    <Grid
        RowDefinitions="Auto,*"
        ColumnDefinitions="280,*"
        Padding="16"
        RowSpacing="12"
        ColumnSpacing="16">

        <!-- Header -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label Text="{Binding WelcomeMessage}" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="Log out" Command="{Binding LogoutCommand}" />
        </Grid>

        <!-- Conversation sidebar -->
        <conv:ConversationSidebar Grid.Row="1" Grid.Column="0" />

        <!-- Chat area -->
        <chat:ChatView x:Name="ChatViewControl" Grid.Row="1" Grid.Column="1" />
    </Grid>
</ContentPage>
